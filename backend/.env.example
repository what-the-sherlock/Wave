# Copy to backend/.env and fill in. `supabase start` prints the values you need.
#
# Getting started:
#   1. npx supabase start        (from the repo root — starts local Postgres/Auth/Storage)
#   2. copy the printed API URL and anon key below
#   3. npx supabase db push --local   (applies supabase/migrations/*.sql)
#   4. npm run dev --workspace backend
#
# `supabase start` also prints a JWT_SECRET value — do NOT set
# SUPABASE_JWT_SECRET from it. Current Supabase (local and most new hosted
# projects) signs access tokens with an asymmetric key ("JWT Signing
# Keys"), not that legacy shared secret; setting it makes verification use
# the wrong algorithm and every request fails with TOKEN_INVALID. Leave it
# unset so verification uses remote JWKS instead (see src/auth/jwt.ts).

NODE_ENV=development
PORT=5001

# Supavisor transaction-mode pooler. `supabase start` prints a direct
# connection string on port 54322 — that's fine for local dev (no pooler
# running locally). In production, use the pooled connection on port 6543.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Leave unset (see note above) unless your specific project is confirmed
# to use the legacy HS256 shared secret rather than JWT Signing Keys.
# SUPABASE_JWT_SECRET=

# Only needed once the worker exists (Phase 5) — bypasses Row-Level
# Security entirely. Never used by the API process. See
# docs/security-model.md §5 and src/config/privileged.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset for a single-host deployment (cookie applies to the exact
# host that set it, which is the safer default).
# COOKIE_DOMAIN=

CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
